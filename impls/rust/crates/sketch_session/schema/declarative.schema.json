{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One command of the declarative subset; `name` is required.",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "arrow": {
          "description": "Arrow heads: `\"none\"`, `\"start\"`, `\"end\"` or `\"both\"`.",
          "enum": [
            "none",
            "start",
            "end",
            "both"
          ],
          "type": "string"
        },
        "color": {
          "description": "sRGB colour #rrggbb.",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "type": "string"
        },
        "dash": {
          "description": "Dash pattern: `\"solid\"`, `\"dashed\"`, `\"dotted\"` or `\"dashdot\"`.",
          "enum": [
            "solid",
            "dashed",
            "dotted",
            "dashdot"
          ],
          "type": "string"
        },
        "end": {
          "description": "Point [x, y].",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "kind": {
          "const": "segment"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "op": {
          "const": "create"
        },
        "role": {
          "description": "Geometry role: `\"result\"` or `\"construction\"`.",
          "enum": [
            "result",
            "construction"
          ],
          "type": "string"
        },
        "start": {
          "description": "Point [x, y].",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "style": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "width": {
          "description": "Stroke width in pt, greater than zero.",
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "op",
        "kind",
        "name",
        "start",
        "end"
      ],
      "title": "create segment",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "arrow": {
          "description": "Arrow heads: `\"none\"`, `\"start\"`, `\"end\"` or `\"both\"`.",
          "enum": [
            "none",
            "start",
            "end",
            "both"
          ],
          "type": "string"
        },
        "center": {
          "description": "Point [x, y].",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "color": {
          "description": "sRGB colour #rrggbb.",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "type": "string"
        },
        "dash": {
          "description": "Dash pattern: `\"solid\"`, `\"dashed\"`, `\"dotted\"` or `\"dashdot\"`.",
          "enum": [
            "solid",
            "dashed",
            "dotted",
            "dashdot"
          ],
          "type": "string"
        },
        "kind": {
          "const": "arc"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "op": {
          "const": "create"
        },
        "radius": {
          "description": "Radius, zero or positive.",
          "format": "double",
          "minimum": 0,
          "type": "number"
        },
        "role": {
          "description": "Geometry role: `\"result\"` or `\"construction\"`.",
          "enum": [
            "result",
            "construction"
          ],
          "type": "string"
        },
        "start_heading": {
          "description": "Heading of the start point from the center, radians from +x.",
          "format": "double",
          "type": "number"
        },
        "style": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "sweep": {
          "description": "Turn from start to end, radians, counterclockwise positive.",
          "format": "double",
          "type": "number"
        },
        "width": {
          "description": "Stroke width in pt, greater than zero.",
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "op",
        "kind",
        "name",
        "center",
        "radius",
        "start_heading",
        "sweep"
      ],
      "title": "create arc",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "arrow": {
          "description": "Arrow heads: `\"none\"`, `\"start\"`, `\"end\"` or `\"both\"`.",
          "enum": [
            "none",
            "start",
            "end",
            "both"
          ],
          "type": "string"
        },
        "color": {
          "description": "sRGB colour #rrggbb.",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "type": "string"
        },
        "dash": {
          "description": "Dash pattern: `\"solid\"`, `\"dashed\"`, `\"dotted\"` or `\"dashdot\"`.",
          "enum": [
            "solid",
            "dashed",
            "dotted",
            "dashdot"
          ],
          "type": "string"
        },
        "halign": {
          "default": "left",
          "description": "Label horizontal alignment: `\"left\"`, `\"center\"` or `\"right\"`.",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "type": "string"
        },
        "heading": {
          "description": "Heading of the baseline, radians from +x.",
          "format": "double",
          "type": "number"
        },
        "kind": {
          "const": "label"
        },
        "markup": {
          "default": "latex",
          "description": "Label markup: `\"latex\"` or `\"text\"`.",
          "enum": [
            "latex",
            "text"
          ],
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "offset": {
          "default": [
            0.0,
            0.0
          ],
          "description": "Offset of the reference point from the origin, in pt, in the label frame.",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "op": {
          "const": "create"
        },
        "origin": {
          "description": "Point [x, y].",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "role": {
          "description": "Geometry role: `\"result\"` or `\"construction\"`.",
          "enum": [
            "result",
            "construction"
          ],
          "type": "string"
        },
        "size": {
          "description": "Size in pt, greater than zero; absent to inherit the document font size.",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "source": {
          "description": "Text, read according to `markup`.",
          "type": "string"
        },
        "style": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "valign": {
          "default": "first",
          "description": "Label vertical anchor: `\"first\"` or `\"last\"`.",
          "enum": [
            "first",
            "last"
          ],
          "type": "string"
        },
        "width": {
          "description": "Stroke width in pt, greater than zero.",
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "op",
        "kind",
        "name",
        "origin",
        "heading",
        "source"
      ],
      "title": "create label",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "a": {
          "description": "Address of a point, e.g. seg1.end or arc1.center.",
          "type": "string"
        },
        "b": {
          "description": "Address of a point, e.g. seg1.end or arc1.center.",
          "type": "string"
        },
        "kind": {
          "const": "join"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "op": {
          "const": "constrain"
        }
      },
      "required": [
        "op",
        "kind",
        "name",
        "a",
        "b"
      ],
      "title": "constrain join",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "a": {
          "description": "Address of a free vector, e.g. seg1.direction or arc1.tangent(0.5).",
          "type": "string"
        },
        "b": {
          "description": "Address of a free vector, e.g. seg1.direction or arc1.tangent(0.5).",
          "type": "string"
        },
        "kind": {
          "const": "parallel"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "op": {
          "const": "constrain"
        }
      },
      "required": [
        "op",
        "kind",
        "name",
        "a",
        "b"
      ],
      "title": "constrain parallel",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "a": {
          "description": "Address of a free vector, e.g. seg1.direction or arc1.tangent(0.5).",
          "type": "string"
        },
        "b": {
          "description": "Address of a free vector, e.g. seg1.direction or arc1.tangent(0.5).",
          "type": "string"
        },
        "kind": {
          "const": "perpendicular"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "op": {
          "const": "constrain"
        }
      },
      "required": [
        "op",
        "kind",
        "name",
        "a",
        "b"
      ],
      "title": "constrain perpendicular",
