{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One command of a drawing session.",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "end": {
          "description": "Point [x, y].",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "kind": {
          "const": "segment"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "op": {
          "const": "create"
        },
        "role": {
          "description": "Geometry role: `\"result\"` or `\"construction\"`.",
          "enum": [
            "result",
            "construction"
          ],
          "type": "string"
        },
        "start": {
          "description": "Point [x, y].",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "op",
        "kind",
        "start",
        "end"
      ],
      "title": "create segment",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "center": {
          "description": "Point [x, y].",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "kind": {
          "const": "arc"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "op": {
          "const": "create"
        },
        "radius": {
          "description": "Radius, zero or positive.",
          "format": "double",
          "minimum": 0,
          "type": "number"
        },
        "role": {
          "description": "Geometry role: `\"result\"` or `\"construction\"`.",
          "enum": [
            "result",
            "construction"
          ],
          "type": "string"
        },
        "start_heading": {
          "description": "Heading of the start point from the center, radians from +x.",
          "format": "double",
          "type": "number"
        },
        "sweep": {
          "description": "Turn from start to end, radians, counterclockwise positive.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "op",
        "kind",
        "center",
        "radius",
        "start_heading",
        "sweep"
      ],
      "title": "create arc",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "halign": {
          "default": "left",
          "description": "Label horizontal alignment: `\"left\"`, `\"center\"` or `\"right\"`.",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "type": "string"
        },
        "heading": {
          "description": "Heading of the baseline, radians from +x.",
          "format": "double",
          "type": "number"
        },
        "kind": {
          "const": "label"
        },
        "markup": {
          "default": "latex",
          "description": "Label markup: `\"latex\"` or `\"text\"`.",
          "enum": [
            "latex",
            "text"
          ],
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "offset": {
          "default": [
            0.0,
            0.0
          ],
          "description": "Offset of the reference point from the origin, in pt, in the label frame.",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "op": {
          "const": "create"
        },
        "origin": {
          "description": "Point [x, y].",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "role": {
          "description": "Geometry role: `\"result\"` or `\"construction\"`.",
          "enum": [
            "result",
            "construction"
          ],
          "type": "string"
        },
        "size": {
          "description": "Size in pt, greater than zero; absent to inherit the document font size.",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "source": {
          "description": "Text, read according to `markup`.",
          "type": "string"
        },
        "valign": {
          "default": "first",
          "description": "Label vertical anchor: `\"first\"` or `\"last\"`.",
          "enum": [
            "first",
            "last"
          ],
          "type": "string"
        }
      },
      "required": [
        "op",
        "kind",
        "origin",
        "heading",
        "source"
      ],
      "title": "create label",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "a": {
          "description": "Address of a point, e.g. seg1.end or arc1.center.",
          "type": "string"
        },
        "b": {
          "description": "Address of a point, e.g. seg1.end or arc1.center.",
          "type": "string"
        },
        "kind": {
          "const": "join"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "op": {
          "const": "constrain"
        }
      },
      "required": [
        "op",
        "kind",
        "a",
        "b"
      ],
      "title": "constrain join",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "a": {
          "description": "Address of a free vector, e.g. seg1.direction or arc1.tangent(0.5).",
          "type": "string"
        },
        "b": {
          "description": "Address of a free vector, e.g. seg1.direction or arc1.tangent(0.5).",
          "type": "string"
        },
        "kind": {
          "const": "parallel"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "op": {
          "const": "constrain"
        }
      },
      "required": [
        "op",
        "kind",
        "a",
        "b"
      ],
      "title": "constrain parallel",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "a": {
          "description": "Address of a free vector, e.g. seg1.direction or arc1.tangent(0.5).",
          "type": "string"
        },
        "b": {
          "description": "Address of a free vector, e.g. seg1.direction or arc1.tangent(0.5).",
          "type": "string"
        },
        "kind": {
          "const": "perpendicular"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "op": {
          "const": "constrain"
        }
      },
      "required": [
        "op",
        "kind",
        "a",
        "b"
      ],
      "title": "constrain perpendicular",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "fix"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "op": {
          "const": "constrain"
        },
        "point": {
          "description": "Address of a point, e.g. seg1.end or arc1.center.",
          "type": "string"
        },
        "target": {
          "description": "Point [x, y].",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "op",
        "kind",
        "point",
        "target"
      ],
      "title": "constrain fix",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "a": {
          "description": "Address of a length, e.g. seg1.length or arc1.radius.",
          "type": "string"
        },
        "b": {
          "description": "Address of a length, e.g. seg1.length or arc1.radius.",
          "type": "string"
        },
        "kind": {
          "const": "equal_length"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "op": {
          "const": "constrain"
        }
      },
      "required": [
        "op",
        "kind",
        "a",
        "b"
      ],
      "title": "constrain equal_length",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "op": {
          "const": "delete"
        }
      },
      "required": [
        "op",
        "name"
      ],
      "title": "delete",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "new_name": {
          "type": "string"
        },
        "op": {
          "const": "rename"
        }
      },
      "required": [
        "op",
        "name",
        "new_name"
      ],
      "title": "rename",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "op": {
          "const": "set_role"
        },
        "role": {
          "description": "Geometry role: `\"result\"` or `\"construction\"`.",
          "enum": [
            "result",
            "construction"
          ],
          "type": "string"
        }
      },
      "required": [
        "op",
        "name",
        "role"
      ],
      "title": "set_role",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "minProperties": 4,
      "properties": {
        "halign": {
          "description": "Label horizontal alignment: `\"left\"`, `\"center\"` or `\"right\"`.",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "type": "string"
        },
        "kind": {
          "const": "label"
        },
        "markup": {
          "description": "Label markup: `\"latex\"` or `\"text\"`.",
          "enum": [
            "latex",
            "text"
          ],
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "offset": {
          "description": "Free vector [dx, dy].",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "op": {
          "const": "set"
        },
        "size": {
          "description": "Size in pt, greater than zero; null to inherit the document font size.",
          "exclusiveMinimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "source": {
          "type": "string"
        },
        "valign": {
          "description": "Label vertical anchor: `\"first\"` or `\"last\"`.",
          "enum": [
            "first",
            "last"
          ],
          "type": "string"
        }
      },
      "required": [
        "op",
        "kind",
        "name"
      ],
      "title": "set label",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "minProperties": 2,
      "properties": {
        "font_size": {
          "description": "Font size of labels that inherit theirs, in pt, greater than zero.",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "op": {
          "const": "set_document"
        },
        "preamble": {
          "description": "LaTeX source with macros for every label in latex markup.",
          "type": "string"
        },
        "scale": {
          "description": "Millimetres per world unit, greater than zero.",
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "op"
      ],
      "title": "set_document",
      "type": "object"
    }
  ],
  "title": "Command"
}
